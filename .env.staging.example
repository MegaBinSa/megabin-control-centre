# Names only and synthetic placeholders. Store real values in GitHub, Supabase,
# and the selected hosting provider's staging secret/config stores.
MEGABIN_ENVIRONMENT=staging
SUPABASE_PROJECT_REF=replace-with-dedicated-staging-project-ref
SUPABASE_URL=https://replace-with-dedicated-staging-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key
SUPABASE_ACCESS_TOKEN=replace-in-github-environment-secret
SUPABASE_DB_PASSWORD=replace-in-github-environment-secret
STAGING_OFFICE_EMAIL=office+staging@example.invalid
STAGING_OFFICE_PASSWORD=replace-in-github-environment-secret
STAGING_DRIVER_EMAIL=driver+staging@example.invalid
STAGING_DRIVER_PASSWORD=replace-in-github-environment-secret
