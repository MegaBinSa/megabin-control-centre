VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key
VITE_MASTER_DATA_API_URL=https://replace-with-dedicated-staging-project-ref.supabase.co/functions/v1/platform-runtime
VITE_DRIVER_API_URL=https://replace-with-dedicated-staging-project-ref.supabase.co/functions/v1/platform-runtime
