{
  "version": 2,
  "environment": "staging",
  "defaultOwner": "Shaun",
  "escalationOwner": "Shaun",
  "deliveryDestination": "github-actions-email",
  "deliveryRecipient": "infomegabin@gmail.com",
  "deliveryVerification": "HUMAN_CONFIRMATION_REQUIRED",
  "severityRouting": {
    "SEV1": "immediate-email",
    "SEV2": "immediate-email",
    "SEV3": "email-no-urgent-escalation"
  },
  "alerts": [
    {
      "sourceWorkflow": "Monitor staging synthetic alert proof",
      "id": "MBA-STG-MON-TEST-001",
      "severity": "SEV3",
      "response": "Confirm the expected GitHub Actions failure notification reached the approved mailbox; no application incident exists."
    },
    {
      "sourceWorkflow": "Monitor staging",
      "id": "MBA-STG-MON-001",
      "severity": "SEV1",
      "response": "Investigate a missed or failed scheduled monitor execution."
    },
    {
      "sourceWorkflow": "Deploy staging",
      "id": "MBA-STG-DEP-001",
      "severity": "SEV1",
      "response": "Stop release acceptance and investigate the failed protected deployment."
    },
    {
      "check": "office_frontend",
      "id": "MBA-STG-WEB-001",
      "severity": "SEV2",
      "response": "Investigate during the active support window."
    },
    {
      "check": "driver_frontend",
      "id": "MBA-STG-WEB-002",
      "severity": "SEV2",
      "response": "Investigate during the active support window."
    },
    {
      "check": "runtime_liveness",
      "id": "MBA-STG-API-001",
      "severity": "SEV1",
      "response": "Shaun acknowledges immediately and begins runtime investigation."
    },
    {
      "check": "release_identity",
      "id": "MBA-STG-REL-001",
      "severity": "SEV2",
      "response": "Stop release acceptance and reconcile deployed identities."
    },
    {
      "check": "allowed_cors_preflight",
      "id": "MBA-STG-SEC-005",
      "severity": "SEV2",
      "response": "Investigate the approved-origin preflight contract."
    },
    {
      "check": "allowed_cors_request",
      "id": "MBA-STG-SEC-001",
      "severity": "SEV2",
      "response": "Investigate the approved-origin contract."
    },
    {
      "check": "allowed_cors_header",
      "id": "MBA-STG-SEC-006",
      "severity": "SEV2",
      "response": "Investigate the approved-origin response header."
    },
    {
      "check": "unknown_cors_denial",
      "id": "MBA-STG-SEC-002",
      "severity": "SEV1",
      "response": "Treat unexpected origin access as a security incident."
    },
    {
      "check": "anonymous_office_denial",
      "id": "MBA-STG-SEC-003",
      "severity": "SEV1",
      "response": "Treat anonymous Office access as a security incident."
    },
    {
      "check": "authenticated_office",
      "id": "MBA-STG-AUTH-001",
      "severity": "SEV2",
      "response": "Investigate Office authentication and authorization."
    },
    {
      "check": "authenticated_driver",
      "id": "MBA-STG-AUTH-002",
      "severity": "SEV2",
      "response": "Investigate Driver authentication and assignment scope."
    },
    {
      "check": "driver_financial_denial",
      "id": "MBA-STG-SEC-004",
      "severity": "SEV1",
      "response": "Treat Driver financial access as a security incident."
    },
    {
      "check": "fake_routing_provider_health",
      "id": "MBA-STG-PRV-001",
      "severity": "SEV2",
      "response": "Confirm the fake routing adapter remains healthy."
    },
    {
      "check": "regional_office_accounting_provider_health_denial",
      "id": "MBA-STG-SEC-007",
      "severity": "SEV1",
      "response": "Treat unintended global accounting-health access as a security incident."
    },
    {
      "check": "regional_office_communications_provider_health_denial",
      "id": "MBA-STG-SEC-008",
      "severity": "SEV1",
      "response": "Treat unintended global communications-health access as a security incident."
    },
    {
      "check": "fake_accounting_provider_configuration",
      "id": "MBA-STG-PRV-002",
      "severity": "SEV1",
      "response": "Stop Staging use if accounting is not fake."
    },
    {
      "check": "capture_communications_configuration",
      "id": "MBA-STG-PRV-003",
      "severity": "SEV1",
      "response": "Stop Staging use if communications are not capture-only."
    },
    {
      "check": "website_onboarding_availability",
      "id": "MBA-STG-INT-001",
      "severity": "SEV2",
      "response": "Investigate the signed non-mutating onboarding boundary."
    },
    {
      "check": "office_profile_cors_preflight",
      "id": "MBA-STG-SEC-009",
      "severity": "SEV2",
      "response": "Investigate approved Office profile preflight access."
    },
    {
      "check": "office_profile_cors_contract",
      "id": "MBA-STG-SEC-010",
      "severity": "SEV2",
      "response": "Investigate the Office profile browser CORS contract."
    },
    {
      "check": "authenticated_office_cors_header",
      "id": "MBA-STG-SEC-011",
      "severity": "SEV2",
      "response": "Investigate the authenticated Office response origin header."
    },
    {
      "check": "regional_office_master_data_read",
      "id": "MBA-STG-API-002",
      "severity": "SEV2",
      "response": "Investigate authorized regional Office master-data availability and scope."
    },
    {
      "check": "regional_office_master_data_cors_header",
      "id": "MBA-STG-SEC-012",
      "severity": "SEV2",
      "response": "Investigate the regional Office master-data response origin header."
    },
    {
      "check": "regional_office_website_intake_read",
      "id": "MBA-STG-INT-002",
      "severity": "SEV2",
      "response": "Investigate authorized regional Website Intake availability and scope."
    },
    {
      "check": "driver_bootstrap_cors_preflight",
      "id": "MBA-STG-SEC-013",
      "severity": "SEV2",
      "response": "Investigate approved Driver bootstrap preflight access."
    },
    {
      "check": "driver_bootstrap_cors_contract",
      "id": "MBA-STG-SEC-014",
      "severity": "SEV2",
      "response": "Investigate the Driver bootstrap browser CORS contract."
    },
    {
      "check": "authenticated_driver_cors_header",
      "id": "MBA-STG-SEC-015",
      "severity": "SEV2",
      "response": "Investigate the authenticated Driver response origin header."
    }
  ]
}
