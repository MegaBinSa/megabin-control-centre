{
  "name": "megabin-control-centre",
  "version": "0.0.0",
  "private": true,
  "description": "MegaBin Control Centre monorepo",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "11.16.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm openapi:check && pnpm docs:check",
    "docs:check": "node scripts/check-doc-links.mjs",
    "env:validate:staging": "node scripts/validate-environment.mjs staging",
    "env:validate:production": "node scripts/validate-environment.mjs production",
    "forward-repair:evidence": "node scripts/forward-repair-evidence.mjs",
    "forward-repair:validate": "node scripts/forward-repair-contract.mjs",
    "migrations:safety": "node scripts/migration-safety.mjs",
    "monitor:staging": "node scripts/operational-monitor.mjs",
    "recovery:validate": "node scripts/recovery-contract.mjs",
    "recovery:evidence": "node scripts/recovery-evidence.mjs",
    "readiness:validate": "node scripts/readiness-gates.mjs",
    "rollback:plan": "node scripts/rollback-rehearsal.mjs",
    "smoke:staging": "node scripts/staging-smoke.mjs",
    "uat:validate": "node scripts/uat-contract.mjs",
    "uat:data:validate": "node scripts/uat-data-contract.mjs",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "openapi:generate": "node scripts/openapi.mjs",
    "openapi:check": "node scripts/openapi.mjs --check",
    "supabase": "supabase",
    "supabase:db:start": "supabase db start",
    "supabase:reset": "supabase db reset --local",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:test:db": "supabase test db --local supabase/tests/database",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --build --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "supabase": "2.114.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
